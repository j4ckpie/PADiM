<!-- K04RelayCommand/MainWindow.xaml -->
<Window x:Class="K04RelayCommand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="K04 – [RelayCommand] {Binding Step}" Height="220" Width="320">
    <StackPanel Margin="16">
        <TextBlock Text="Wartość licznika:" />
        <TextBlock Text="{Binding Value}" FontSize="32" FontWeight="Bold" />

        <!-- Command zamiast Click: brak metod w code-behind -->
        <StackPanel Orientation="Horizontal">
            <Button Content="{Binding Step}" ContentStringFormat="+{0}" Command="{Binding IncrementCommand}" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="{Binding Step}" ContentStringFormat="-{0}" Command="{Binding DecrementCommand}" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="Zeruj" Command="{Binding ResetCommand}" Padding="12,4" />
        </StackPanel>

        <TextBlock Text="Krok:" Margin="0,12,0,0" />
        <TextBox Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}" FontSize="18" />
    </StackPanel>
</Window>